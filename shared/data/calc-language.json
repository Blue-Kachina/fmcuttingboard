{
  "$schema": "../schemas/calc-language.schema.json",
  "about": "Interim, hand-curated FileMaker calculation language facts (constants, Get() names, operators, syntax), each sourced from help.claris.com. Same shapes as the matching parts of fm-calc-catalogue/v1; superseded by shared/data/fm-calc-catalogue.json once fmscriptinventory delivers it (docs/fm-calc-catalogue-contract.md).",
  "getConstants": [
    { "name": "AccountName" },
    { "name": "ApplicationLanguage" },
    { "name": "CurrentTimeUTCMilliseconds" },
    { "name": "Device" },
    { "name": "DocumentsPath" },
    { "name": "FileName" },
    { "name": "HostName" },
    { "name": "LastError" },
    { "name": "LayoutName" },
    { "name": "ModelName" },
    { "name": "ModifiedFields" },
    { "name": "NetworkProtocol" },
    { "name": "PersistentID" },
    { "name": "PreferencesPath" },
    { "name": "ScreenScale" },
    { "name": "ScriptName" },
    { "name": "SystemLanguage" },
    { "name": "TotalRecordCount" },
    { "name": "UserName" },
    { "name": "WindowName" }
  ],
  "constants": [
    { "name": "True", "group": "boolean", "value": 1, "helpUrl": "https://help.claris.com/en/pro-help/content/logical-functions.html" },
    { "name": "False", "group": "boolean", "value": 0, "helpUrl": "https://help.claris.com/en/pro-help/content/logical-functions.html" },
    { "name": "JSONRaw", "group": "json-type", "value": 0, "lifecycle": { "since": "16.0" }, "helpUrl": "https://help.claris.com/en/pro-help/content/jsonsetelement.html" },
    { "name": "JSONString", "group": "json-type", "value": 1, "lifecycle": { "since": "16.0" }, "helpUrl": "https://help.claris.com/en/pro-help/content/jsonsetelement.html" },
    { "name": "JSONNumber", "group": "json-type", "value": 2, "lifecycle": { "since": "16.0" }, "helpUrl": "https://help.claris.com/en/pro-help/content/jsonsetelement.html" },
    { "name": "JSONObject", "group": "json-type", "value": 3, "lifecycle": { "since": "16.0" }, "helpUrl": "https://help.claris.com/en/pro-help/content/jsonsetelement.html" },
    { "name": "JSONArray", "group": "json-type", "value": 4, "lifecycle": { "since": "16.0" }, "helpUrl": "https://help.claris.com/en/pro-help/content/jsonsetelement.html" },
    { "name": "JSONBoolean", "group": "json-type", "value": 5, "lifecycle": { "since": "16.0" }, "helpUrl": "https://help.claris.com/en/pro-help/content/jsonsetelement.html" },
    { "name": "JSONNull", "group": "json-type", "value": 6, "lifecycle": { "since": "16.0" }, "helpUrl": "https://help.claris.com/en/pro-help/content/jsonsetelement.html" },
    { "name": "Plain", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Bold", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Italic", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Underline", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "HighlightYellow", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Condense", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Extend", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Strikethrough", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "SmallCaps", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Superscript", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Subscript", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Uppercase", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Lowercase", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "Titlecase", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "WordUnderline", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "DoubleUnderline", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" },
    { "name": "AllStyles", "group": "text-style", "value": null, "helpUrl": "https://help.claris.com/en/pro-help/content/textstyleadd.html" }
  ],
  "operators": [
    { "symbol": "not", "name": "logical not", "kind": "logical", "arity": 1, "precedence": 8, "associativity": "right", "helpUrl": "https://help.claris.com/en/pro-help/content/logical-operators.html" },
    { "symbol": "^", "name": "power", "kind": "arithmetic", "arity": 2, "precedence": 7, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/mathematical-operators.html" },
    { "symbol": "*", "name": "multiplication", "kind": "arithmetic", "arity": 2, "precedence": 6, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/mathematical-operators.html" },
    { "symbol": "/", "name": "division", "kind": "arithmetic", "arity": 2, "precedence": 6, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/mathematical-operators.html" },
    { "symbol": "+", "name": "addition", "kind": "arithmetic", "arity": 2, "precedence": 5, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/mathematical-operators.html" },
    { "symbol": "-", "name": "subtraction", "kind": "arithmetic", "arity": 2, "precedence": 5, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/mathematical-operators.html" },
    { "symbol": "&", "name": "concatenation", "kind": "text", "arity": 2, "precedence": 4, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/text-operators.html" },
    { "symbol": "=", "name": "equal", "kind": "comparison", "arity": 2, "precedence": 3, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/comparison-operators.html" },
    { "symbol": "≠", "alternates": ["<>"], "name": "not equal", "kind": "comparison", "arity": 2, "precedence": 3, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/comparison-operators.html" },
    { "symbol": ">", "name": "greater than", "kind": "comparison", "arity": 2, "precedence": 3, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/comparison-operators.html" },
    { "symbol": "<", "name": "less than", "kind": "comparison", "arity": 2, "precedence": 3, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/comparison-operators.html" },
    { "symbol": "≥", "alternates": [">="], "name": "greater than or equal", "kind": "comparison", "arity": 2, "precedence": 3, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/comparison-operators.html" },
    { "symbol": "≤", "alternates": ["<="], "name": "less than or equal", "kind": "comparison", "arity": 2, "precedence": 3, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/comparison-operators.html" },
    { "symbol": "and", "name": "logical and", "kind": "logical", "arity": 2, "precedence": 2, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/logical-operators.html" },
    { "symbol": "or", "name": "logical or", "kind": "logical", "arity": 2, "precedence": 1, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/logical-operators.html" },
    { "symbol": "xor", "name": "logical exclusive or", "kind": "logical", "arity": 2, "precedence": 1, "associativity": "left", "helpUrl": "https://help.claris.com/en/pro-help/content/logical-operators.html" }
  ],
  "syntax": {
    "argumentSeparator": ";",
    "stringDelimiter": "\"",
    "stringEscapes": [
      { "sequence": "\\\"", "meaning": "a quotation mark inside a text constant" },
      { "sequence": "\\\\", "meaning": "a backslash inside a text constant" },
      { "sequence": "\\¶", "meaning": "a literal pilcrow instead of a return" }
    ],
    "paragraphMark": "¶",
    "lineComment": "//",
    "blockComment": ["/*", "*/"],
    "fieldReference": "Table::Field",
    "repetitionBrackets": ["[", "]"],
    "variablePrefixes": [
      { "prefix": "$$", "scope": "file (global)" },
      { "prefix": "$", "scope": "script (local)" }
    ],
    "caseSensitive": { "functionNames": false },
    "notes": [
      "Operator precedence: help.claris.com/en/pro-help/content/operators-in-formulas.html (higher number binds tighter).",
      "${ } quotes reserved function names and keywords used as field or table names (text-operators.html)."
    ]
  }
}
