{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fm-calc-catalogue.schema.json",
  "title": "FileMaker calculation catalogue export (fm-calc-catalogue/v1)",
  "description": "Produced by the sister repo fmscriptinventory, vendored into FMCuttingBoard at shared/data/fm-calc-catalogue.json by shared/tools/sync-calc-catalogue.mjs. Facts plus links only: no text copied from Claris documentation (see docs/fm-calc-catalogue-contract.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "generator", "locale", "documentedFileMakerVersion", "categories", "functions", "getConstants", "constants", "operators", "syntax"],
  "definitions": {
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$", "description": "FileMaker version, e.g. \"19.6\"" },
    "nullableVersion": { "oneOf": [{ "$ref": "#/definitions/version" }, { "type": "null" }] },
    "dataType": {
      "enum": ["text", "number", "date", "time", "timestamp", "container", "boolean", "json", "any", "expression", "fieldReference", "variableBindings"],
      "description": "boolean = number used as true/false; expression = unevaluated calculation text (e.g. Evaluate); fieldReference = must be a field, not an expression (e.g. GetRepetition); variableBindings = Let's [ name = value ; ... ] block"
    },
    "url": { "type": "string", "pattern": "^https://" },
    "summary": { "type": "string", "maxLength": 300, "description": "Written by us, never copied from Claris documentation" },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["since"],
      "properties": {
        "since": { "$ref": "#/definitions/version" },
        "sinceRaw": { "type": "string", "description": "Help wording when not exact, e.g. \"6.0 or earlier\"" },
        "deprecatedIn": { "$ref": "#/definitions/nullableVersion" },
        "removedIn": { "$ref": "#/definitions/nullableVersion" }
      }
    },
    "compatibility": {
      "type": "object",
      "description": "Help's own product keys and values (e.g. {\"FileMaker Pro\": \"Yes\", \"FileMaker Go\": \"Partial\"})",
      "additionalProperties": { "enum": ["Yes", "No", "Partial"] }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "optional", "repeatable"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/definitions/dataType" },
        "optional": { "type": "boolean" },
        "repeatable": { "type": "boolean", "description": "May be repeated (alone, or together with the other parameters of its group)" },
        "group": {
          "type": "string",
          "description": "Parameters sharing a group repeat together, e.g. Case's test/result pairs both have group \"pair\""
        },
        "allowedConstants": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Names from `constants` this parameter accepts, e.g. JSONSetElement's type -> JSONString, JSONNumber, ..."
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "fm-calc-catalogue/v1" },
    "generatedAt": { "type": "string", "description": "ISO 8601 timestamp" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit"],
      "properties": {
        "repo": { "type": "string", "description": "e.g. Blue-Kachina/fmscriptinventory" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "locale": { "type": "string", "description": "Locale of names/labels; function names in calculations are English in every locale" },
    "documentedFileMakerVersion": { "$ref": "#/definitions/version" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string" },
          "helpUrl": { "$ref": "#/definitions/url" }
        }
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "returnType", "parameters", "minArgs", "maxArgs", "signature", "lifecycle", "helpUrl"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]*$", "description": "Exactly as typed in a calculation" },
          "category": { "type": "string", "description": "A categories[].key" },
          "returnType": { "$ref": "#/definitions/dataType" },
          "parameters": { "type": "array", "items": { "$ref": "#/definitions/parameter" } },
          "minArgs": { "type": "integer", "minimum": 0 },
          "maxArgs": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }], "description": "null = unlimited" },
          "signature": { "type": "string", "description": "Canonical syntax line, e.g. \"Left ( text ; numberOfCharacters )\"" },
          "lifecycle": { "$ref": "#/definitions/lifecycle" },
          "compatibility": { "$ref": "#/definitions/compatibility" },
          "helpUrl": { "$ref": "#/definitions/url" },
          "summary": { "$ref": "#/definitions/summary" },
          "related": { "type": "array", "items": { "type": "string" } },
          "verified": {
            "type": "object",
            "description": "Argument counts confirmed in FileMaker itself (e.g. IsValidExpression in EverythingBagel.fmp12)",
            "additionalProperties": false,
            "required": ["fileMakerVersion", "minArgs", "maxArgs"],
            "properties": {
              "fileMakerVersion": { "$ref": "#/definitions/version" },
              "minArgs": { "type": "boolean" },
              "maxArgs": { "type": "boolean" }
            }
          }
        }
      }
    },
    "getConstants": {
      "type": "array",
      "description": "Arguments of Get ( ... ), e.g. AccountName",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "returnType", "lifecycle", "helpUrl"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "returnType": { "$ref": "#/definitions/dataType" },
          "lifecycle": { "$ref": "#/definitions/lifecycle" },
          "compatibility": { "$ref": "#/definitions/compatibility" },
          "helpUrl": { "$ref": "#/definitions/url" },
          "summary": { "$ref": "#/definitions/summary" }
        }
      }
    },
    "constants": {
      "type": "array",
      "description": "Named constants usable in calculations: True/False, JSON types, text styles, etc.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "group"],
        "properties": {
          "name": { "type": "string" },
          "group": { "type": "string", "description": "e.g. boolean, json-type, text-style" },
          "value": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "null" }] },
          "lifecycle": { "$ref": "#/definitions/lifecycle" },
          "helpUrl": { "$ref": "#/definitions/url" }
        }
      }
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "name", "kind", "arity", "precedence", "associativity"],
        "properties": {
          "symbol": { "type": "string", "description": "Primary spelling, e.g. \"≠\"" },
          "alternates": { "type": "array", "items": { "type": "string" }, "description": "e.g. [\"<>\"]" },
          "name": { "type": "string" },
          "kind": { "enum": ["arithmetic", "text", "comparison", "logical", "grouping", "reference"] },
          "arity": { "enum": [1, 2] },
          "precedence": { "type": "integer", "minimum": 1, "description": "Higher binds tighter" },
          "associativity": { "enum": ["left", "right", "none"] },
          "helpUrl": { "$ref": "#/definitions/url" }
        }
      }
    },
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argumentSeparator", "stringDelimiter", "stringEscapes", "paragraphMark", "lineComment", "blockComment", "fieldReference", "repetitionBrackets", "variablePrefixes"],
      "properties": {
        "argumentSeparator": { "type": "string" },
        "stringDelimiter": { "type": "string" },
        "stringEscapes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "meaning"],
            "properties": { "sequence": { "type": "string" }, "meaning": { "type": "string" } }
          }
        },
        "paragraphMark": { "type": "string" },
        "lineComment": { "type": "string" },
        "blockComment": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
        "fieldReference": { "type": "string", "description": "e.g. \"Table::Field\"" },
        "repetitionBrackets": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
        "variablePrefixes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prefix", "scope"],
            "properties": { "prefix": { "type": "string" }, "scope": { "type": "string" } }
          }
        },
        "caseSensitive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "functionNames": { "type": "boolean" },
            "variables": { "type": "boolean" },
            "fieldNames": { "type": "boolean" }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "errorCodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "label"],
        "properties": {
          "code": { "type": "integer" },
          "label": { "type": "string", "maxLength": 120, "description": "Short label, written by us" },
          "lifecycle": { "$ref": "#/definitions/lifecycle" },
          "helpUrl": { "$ref": "#/definitions/url" }
        }
      }
    }
  }
}
