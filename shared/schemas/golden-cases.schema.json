{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "golden-cases.schema.json",
  "title": "Hand-written golden cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["byteVariants", "detection", "normalizeToXmlText", "decodeBytesWithBomHeuristics", "extractFmxmlFromBytes", "parseSnippet", "fmSnippetDetectTypes", "fileNaming"],
  "definitions": {
    "nullableString": { "type": ["string", "null"] },
    "elementType": { "enum": ["FIELDS", "SCRIPTS", "TABLES", "LAYOUTS", "CUSTOM_FUNCTIONS", "VALUE_LISTS", "UNKNOWN"] },
    "byteInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expect"],
      "oneOf": [
        { "required": ["hex"], "not": { "anyOf": [{ "required": ["text"] }, { "required": ["encoding"] }] } },
        { "required": ["text", "encoding"], "not": { "required": ["hex"] } }
      ],
      "properties": {
        "id": { "type": "string" },
        "hex": { "type": "string", "pattern": "^([0-9A-Fa-f]{2})*$" },
        "text": { "type": "string" },
        "encoding": { "enum": ["utf8", "utf16le", "utf16be"] },
        "expect": { "$ref": "#/definitions/nullableString" },
        "note": { "type": "string" }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "about": { "type": "string" },
    "byteVariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variants"],
      "properties": {
        "about": { "type": "string" },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "build", "decode", "extract"],
            "properties": {
              "id": {
                "enum": ["utf8", "utf8-bom", "utf16le", "utf16le-bom", "utf16le-nul-terminated", "utf16be", "utf16be-bom", "custom-format-payload"]
              },
              "build": { "type": "string" },
              "decode": { "enum": ["text", "skip"] },
              "extract": { "enum": ["snippet", "lf-snippet"] }
            }
          }
        }
      }
    },
    "detection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "expect"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "expect": {
            "enum": ["SCRIPT", "SCRIPT_STEPS", "FIELD_DEFINITION", "TABLE_DEFINITION", "CUSTOM_FUNCTION", "VALUE_LIST", "LAYOUT_OBJECTS", "UNKNOWN"]
          }
        }
      }
    },
    "normalizeToXmlText": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expect"],
        "properties": {
          "id": { "type": "string" },
          "input": { "type": "string" },
          "expect": { "$ref": "#/definitions/nullableString" }
        }
      }
    },
    "decodeBytesWithBomHeuristics": { "type": "array", "items": { "$ref": "#/definitions/byteInput" } },
    "extractFmxmlFromBytes": { "type": "array", "items": { "$ref": "#/definitions/byteInput" } },
    "parseSnippet": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "xml"],
        "oneOf": [
          { "required": ["error"], "not": { "anyOf": [{ "required": ["expect"] }, { "required": ["payload"] }, { "required": ["payloadError"] }] } },
          { "required": ["expect", "payload"], "not": { "anyOf": [{ "required": ["error"] }, { "required": ["payloadError"] }] } },
          { "required": ["expect", "payloadError"], "not": { "anyOf": [{ "required": ["error"] }, { "required": ["payload"] }] } }
        ],
        "properties": {
          "id": { "type": "string" },
          "xml": { "type": "string" },
          "error": { "type": "string", "description": "FmXmlParser.parse must fail with exactly this message" },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["elementTypes", "version", "typeHint", "fieldNames", "layoutNames", "scriptNames"],
            "properties": {
              "elementTypes": { "type": "array", "items": { "$ref": "#/definitions/elementType" } },
              "version": { "$ref": "#/definitions/nullableString" },
              "typeHint": { "$ref": "#/definitions/nullableString" },
              "fieldNames": { "type": "array", "items": { "type": "string" } },
              "layoutNames": { "type": "array", "items": { "type": "string" } },
              "scriptNames": { "type": "array", "items": { "type": "string" } }
            }
          },
          "payload": { "type": "string", "description": "DefaultXmlToClipboardConverter result" },
          "payloadError": { "type": "string", "description": "DefaultXmlToClipboardConverter must fail with exactly this message" }
        }
      }
    },
    "fmSnippetDetectTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "xml", "expect"],
        "properties": {
          "id": { "type": "string" },
          "xml": { "type": "string" },
          "expect": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/elementType" } }
        }
      }
    },
    "fileNaming": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "extension", "nowMillis", "existing", "expect"],
        "properties": {
          "id": { "type": "string" },
          "pattern": { "$ref": "#/definitions/nullableString" },
          "extension": { "type": "string", "pattern": "^\\." },
          "nowMillis": { "type": "integer", "minimum": 0 },
          "existing": { "type": "array", "items": { "type": "string" } },
          "expect": { "type": "string" }
        }
      }
    }
  }
}
