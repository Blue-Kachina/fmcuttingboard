<fmxmlsnippet type="FMObjectList">
  <Script includeInMenu="True" runFullAccess="False" id="12" name="Greet user">
    <Step enable="True" id="89" name="# (comment)">
      <Text>Synthetic fixture: non-ASCII on purpose — café, naïve, 日本語, 🙂</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA["Hello, " & Get ( AccountName ) & " ✓"]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$greeting</Name>
    </Step>
    <Step enable="True" id="87" name="Show Custom Dialog">
      <Title>
        <Calculation><![CDATA["Welcome"]]></Calculation>
      </Title>
      <Message>
        <Calculation><![CDATA[$greeting]]></Calculation>
      </Message>
    </Step>
  </Script>
</fmxmlsnippet>
