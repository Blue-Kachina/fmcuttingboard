        "KEYWORD_FUNCTION:Get",
        "LPAREN:(",
        "GET_CONSTANT:AccountName",
        "RPAREN:)",
        "OPERATOR:&",
        "KEYWORD_FUNCTION:get",
        "LPAREN:(",
        "GET_CONSTANT:SomeFutureConstant",
        "RPAREN:)",
        "OPERATOR:&",
        "KEYWORD_FUNCTION:Left",
        "LPAREN:(",
        "IDENTIFIER:x",
        "OPERATOR:;",
        "NUMBER:1",
        "RPAREN:)"
      ]
    },
    {
      "id": "named-constants",
      "calc": "True and jsonstring or Bold xor Trueness",
      "tokens": [
        "CONSTANT:True",
        "KEYWORD_LOGICAL:and",
        "CONSTANT:jsonstring",
        "KEYWORD_LOGICAL:or",
        "CONSTANT:Bold",
        "KEYWORD_LOGICAL:xor",
        "IDENTIFIER:Trueness"
      ]
    },
    {
      "id": "logical-keywords-any-case",
      "calc": "AnD OR Not",
      "tokens": [
        "KEYWORD_LOGICAL:AnD",
        "KEYWORD_LOGICAL:OR",
        "KEYWORD_LOGICAL:Not"
      ]
    },
    {
      "id": "variables",
      "calc": "$local & $$global & $~x & $",
      "tokens": [
        "IDENTIFIER:$local",
        "OPERATOR:&",
        "IDENTIFIER:$$global",
        "OPERATOR:&",
        "IDENTIFIER:$~x",
        "OPERATOR:&",
        "BAD_CHARACTER:$"
      ]
    },
    {
      "id": "unicode-names",
      "calc": "顧客::名前 & 自作関数 ( 1 )",
