        "OPERATOR:+",
        "IDENTIFIER:notes"
      ]
    },
    {
      "id": "numbers",
      "calc": "1 + 2.5 - .5e3 * 3E-2",
      "tokens": [
        "NUMBER:1",
        "OPERATOR:+",
