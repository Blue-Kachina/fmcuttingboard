  "lexer": [
    {
      "id": "field-references",
      "calc": "Contacts::FirstName & Contacts :: Last_Name",
      "tokens": [
        "FIELD_REFERENCE:Contacts::FirstName",
        "OPERATOR:&",
        "FIELD_REFERENCE:Contacts :: Last_Name"
      ]
    },
    {
      "id": "paragraph-mark",
      "calc": "\"a\" & ¶ & \"b\"",
      "tokens": [
        "STRING:\"a\"",
        "OPERATOR:&",
        "PARAGRAPH_MARK:¶",
        "OPERATOR:&",
        "STRING:\"b\""
      ]
    },
    {
      "id": "quoted-names",
      "calc": "${Table::If} + 1",
      "tokens": [
        "QUOTED_NAME:${Table::If}",
        "OPERATOR:+",
        "NUMBER:1"
      ]
    },
    {
      "id": "no-java-keywords",
      "calc": "boolean + int + void",
      "tokens": [
        "IDENTIFIER:boolean",
        "OPERATOR:+",
        "IDENTIFIER:int",
        "OPERATOR:+",
        "IDENTIFIER:void"
      ]
    },
    {
      "id": "single-quotes-are-not-strings",
      "calc": "'lo'",
      "tokens": [
        "BAD_CHARACTER:'",
        "IDENTIFIER:lo",
        "BAD_CHARACTER:'"
      ]
    },
    {
      "id": "strings-span-lines-and-escape",
      "calc": "\"multi\nline \\\"quoted\\\" ¶\"",
