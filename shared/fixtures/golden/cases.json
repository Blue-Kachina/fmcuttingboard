        "OPERATOR:*",
        "NUMBER:3E-2"
      ]
    },
    {
      "id": "operators",
      "calc": "a <> b ≠ c <= d ≤ e >= f ≥ g = h ^ i , j",
      "tokens": [
        "IDENTIFIER:a",
        "OPERATOR:<>",
        "IDENTIFIER:b",
        "OPERATOR:≠",
        "IDENTIFIER:c",
        "OPERATOR:<=",
        "IDENTIFIER:d",
        "OPERATOR:≤",
        "IDENTIFIER:e",
        "OPERATOR:>=",
        "IDENTIFIER:f",
        "OPERATOR:≥",
        "IDENTIFIER:g",
        "OPERATOR:=",
        "IDENTIFIER:h",
        "OPERATOR:^",
        "IDENTIFIER:i",
        "OPERATOR:,",
        "IDENTIFIER:j"
      ]
    },
    {
      "id": "comments",
      "calc": "1 // line\n/* block\n ( */ 2",
      "tokens": [
        "NUMBER:1",
        "LINE_COMMENT:// line",
        "BLOCK_COMMENT:/* block\n ( */",
        "NUMBER:2"
      ],
      "note": "Consecutive BLOCK_COMMENT tokens are merged (the JFlex lexer emits one per character)"
    },
    {
      "id": "brackets-and-repetitions",
      "calc": "Let ( [ a = 1 ] ; Table::F[2] )",
      "tokens": [
        "KEYWORD_FUNCTION:Let",
        "LPAREN:(",
        "LBRACKET:[",
        "IDENTIFIER:a",
        "OPERATOR:=",
        "NUMBER:1",
        "RBRACKET:]",
        "OPERATOR:;",
        "FIELD_REFERENCE:Table::F",
        "LBRACKET:[",
        "NUMBER:2",
        "RBRACKET:]",
        "RPAREN:)"
      ]
    },
    {
      "id": "dotted-names",
      "calc": "a.b + Table.X::Field.Y",
      "tokens": [
        "IDENTIFIER:a.b",
        "OPERATOR:+",
        "FIELD_REFERENCE:Table.X::Field.Y"
      ]
    }
