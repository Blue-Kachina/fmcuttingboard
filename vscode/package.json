{
  "name": "fmcuttingboard",
  "displayName": "FMCuttingBoard",
  "description": "Move FileMaker objects (scripts, fields, tables, layouts, custom functions, value lists) between FileMaker's clipboard and editable fmxmlsnippet XML.",
  "version": "0.0.1",
  "publisher": "bluekachina",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/Blue-Kachina/fmcuttingboard/tree/master/vscode#readme",
  "bugs": {
    "url": "https://github.com/Blue-Kachina/fmcuttingboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Blue-Kachina/fmcuttingboard.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "FileMaker",
    "fmxmlsnippet",
    "clipboard"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:xml",
    "onLanguage:fmcalc"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fmcalc",
        "aliases": [
          "FileMaker Calculation",
          "fmcalc"
        ],
        "extensions": [
          ".fmcalc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fmcalc",
        "scopeName": "source.fmcalc",
        "path": "./syntaxes/fmcalc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fmcalc",
        "path": "./snippets/fmcalc.json"
      }
    ],
    "commands": [
      {
        "command": "fmcuttingboard.getFileMakerClipboardContent",
        "title": "Get FileMaker Clipboard Content",
        "category": "FMCuttingBoard"
      },
      {
        "command": "fmcuttingboard.pushClipboardIntoFileMaker",
        "title": "Push Clipboard Into FileMaker",
        "category": "FMCuttingBoard",
        "icon": "$(clippy)"
      },
      {
        "command": "fmcuttingboard.readClipboardIntoNewXmlFile",
        "title": "New XML File From FM Clipboard",
        "category": "FMCuttingBoard"
      },
      {
        "command": "fmcuttingboard.getFileMakerCalculationFromClipboard",
        "title": "Get FileMaker Calculation From Clipboard",
        "category": "FMCuttingBoard"
      },
      {
        "command": "fmcuttingboard.convertClipboardToXml",
        "title": "Convert FM Clipboard To XML Clipboard",
        "category": "FMCuttingBoard"
      },
      {
        "command": "fmcuttingboard.dumpClipboardFormats",
        "title": "Diagnostics: Dump Clipboard Formats",
        "category": "FMCuttingBoard"
      },
      {
        "command": "fmcuttingboard.saveRawClipboardCapture",
        "title": "Diagnostics: Save Raw Clipboard Capture",
        "category": "FMCuttingBoard"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "fmcuttingboard.readClipboardIntoNewXmlFile",
          "when": "false"
        },
        {
          "command": "fmcuttingboard.getFileMakerCalculationFromClipboard",
          "when": "false"
        },
        {
          "command": "fmcuttingboard.convertClipboardToXml",
          "when": "false"
        },
        {
          "command": "fmcuttingboard.pushClipboardIntoFileMaker",
          "when": "resourceExtname == .xml"
        },
        {
          "command": "fmcuttingboard.dumpClipboardFormats",
          "when": "config.fmcuttingboard.enableDiagnostics"
        },
        {
          "command": "fmcuttingboard.saveRawClipboardCapture",
          "when": "config.fmcuttingboard.enableDiagnostics"
        }
      ],
      "editor/context": [
        {
          "command": "fmcuttingboard.getFileMakerClipboardContent",
          "group": "fmcuttingboard@1"
        },
        {
          "command": "fmcuttingboard.pushClipboardIntoFileMaker",
          "when": "resourceExtname == .xml",
          "group": "fmcuttingboard@2"
        },
        {
          "command": "fmcuttingboard.dumpClipboardFormats",
          "when": "config.fmcuttingboard.enableDiagnostics",
          "group": "fmcuttingboard@3"
        },
        {
          "command": "fmcuttingboard.saveRawClipboardCapture",
          "when": "config.fmcuttingboard.enableDiagnostics",
          "group": "fmcuttingboard@4"
        }
      ],
      "explorer/context": [
        {
          "command": "fmcuttingboard.getFileMakerClipboardContent",
          "group": "fmcuttingboard@1"
        },
        {
          "command": "fmcuttingboard.pushClipboardIntoFileMaker",
          "when": "resourceExtname == .xml",
          "group": "fmcuttingboard@2"
        },
        {
          "command": "fmcuttingboard.dumpClipboardFormats",
          "when": "config.fmcuttingboard.enableDiagnostics",
          "group": "fmcuttingboard@3"
        },
        {
          "command": "fmcuttingboard.saveRawClipboardCapture",
          "when": "config.fmcuttingboard.enableDiagnostics",
          "group": "fmcuttingboard@4"
        }
      ],
      "editor/title": [
        {
          "command": "fmcuttingboard.pushClipboardIntoFileMaker",
          "when": "fmcuttingboard.activeEditorIsFmxmlsnippet",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fmcuttingboard.getFileMakerClipboardContent",
        "key": "ctrl+alt+c x"
      },
      {
        "command": "fmcuttingboard.pushClipboardIntoFileMaker",
        "key": "ctrl+alt+c p",
        "when": "resourceExtname == .xml"
      }
    ],
    "configuration": {
      "title": "FMCuttingBoard",
      "properties": {
        "fmcuttingboard.baseDirName": {
          "type": "string",
          "default": ".fmCuttingBoard",
          "scope": "resource",
          "markdownDescription": "Folder (relative to the workspace folder) where clipboard content is saved. A `.gitignore` that ignores everything is created in it when the folder is first created."
        },
        "fmcuttingboard.fileNamePattern": {
          "type": "string",
          "default": "{timestamp}",
          "scope": "resource",
          "markdownDescription": "File name for saved clipboard content, without extension (`.xml` or `.fmcalc` is added). `{timestamp}` is replaced with the current time in milliseconds; `-1`, `-2`, … is added if the name is taken."
        },
        "fmcuttingboard.previewBeforeClipboardWrite": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Show a preview and ask for confirmation before replacing the clipboard."
        },
        "fmcuttingboard.enableDiagnostics": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Show the diagnostics commands (**Dump Clipboard Formats**, **Save Raw Clipboard Capture**). For detailed logs, set the **FMCuttingBoard** output channel's log level with **Developer: Set Log Level…**."
        },
        "fmcuttingboard.format.maxLineLength": {
          "type": "integer",
          "default": 120,
          "minimum": 20,
          "scope": "resource",
          "markdownDescription": "`.fmcalc` formatting: a function call that fits within this many columns stays on one line; longer ones get one argument per line. (JetBrains: *Hard wrap at*.)"
        },
        "fmcuttingboard.format.doNotIndentTopLetVariables": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "`.fmcalc` formatting: leave the variables of the outermost `Let ( [ … ] ; … )` flush with the `Let`, so a calculation wrapped in a Let isn't indented."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "node scripts/generate-grammar.mjs --check && npm run typecheck && npm run test",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test:integration": "node esbuild.mjs && node esbuild.mjs --integration && vscode-test",
    "generate:grammar": "node scripts/generate-grammar.mjs",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/Blue-Kachina/fmcuttingboard/blob/master/vscode --baseImagesUrl https://github.com/Blue-Kachina/fmcuttingboard/raw/master/vscode"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.35",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "ovsx": "1.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "galleryBanner": {
    "color": "#3B2A1A",
    "theme": "dark"
  }
}
