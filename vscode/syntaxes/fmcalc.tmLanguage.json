{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FileMaker Calculation",
  "scopeName": "source.fmcalc",
  "comment": "GENERATED by scripts/generate-grammar.mjs from shared/data. Do not edit by hand.",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#quoted-names"
        },
        {
          "include": "#get-call"
        },
        {
          "include": "#function-calls"
        },
        {
          "include": "#field-references"
        },
        {
          "include": "#variables"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fmcalc",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fmcalc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.fmcalc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.fmcalc",
          "match": "\\\\."
        },
        {
          "name": "constant.character.paragraph.fmcalc",
          "match": "¶"
        }
      ]
    },
    "quoted-names": {
      "comment": "${ } quotes reserved names used as field or table names",
      "name": "variable.other.quoted.fmcalc",
      "match": "\\$\\{[^}]*\\}"
    },
    "get-call": {
      "comment": "Get ( ConstantName ): any name is accepted, so the grammar does not depend on a complete list",
      "match": "(?i)\\b(Get)\\s*(\\()\\s*([A-Za-z][A-Za-z0-9]*)\\s*(\\))",
      "captures": {
        "1": {
          "name": "support.function.builtin.fmcalc"
        },
        "2": {
          "name": "punctuation.section.arguments.begin.fmcalc"
        },
        "3": {
          "name": "support.constant.get.fmcalc"
        },
        "4": {
          "name": "punctuation.section.arguments.end.fmcalc"
        }
      }
    },
    "function-calls": {
      "patterns": [
        {
          "comment": "Built-in functions from shared data (function names are case-insensitive in FileMaker)",
          "match": "(?i)\\b(ConvertFromFileMakerPath|GetLayoutObjectAttribute|GetLayoutObjectOwnerInfo|GetRecordIDsFromFoundSet|ConvertToFileMakerPath|CryptGenerateSignature|GetContainerAttribute|ListPersistentDataIDs|CryptVerifySignature|GetAVPlayerAttribute|CryptDecryptBase64|CryptEncryptBase64|GetEmbeddingAsFile|GetEmbeddingAsText|GetModelAttributes|GetNextSerialValue|JSONFormatElements|JSONGetElementType|NormalizeEmbedding|SubtractEmbeddings|FieldDisplayNames|GetFieldsOnLayout|GetLiveTextAsJSON|GetPersistentData|IsValidExpression|JSONDeleteElement|LayoutObjectNames|BaseTableComment|CosineSimilarity|FieldRepetitions|GetBaseTableName|LayoutObjectUUID|PredictFromModel|TextFormatRemove|WeekOfYearFiscal|Base64EncodeRFC|EvaluationError|FieldAnnotation|GetAsURLEncoded|GetRAGSpaceInfo|JSONParsedState|SerialIncrement|TextColorRemove|TextStyleRemove|VerifyContainer|BaseTableNames|GetAsTimestamp|GetTextFromPDF|JSONGetElement|JSONListValues|JSONSetElement|LocationValues|TextFontRemove|TextSizeRemove|ValueListItems|ValueListNames|AddEmbeddings|CryptAuthCode|DatabaseNames|GetRepetition|GetTokenCount|JSONMakeArray|Base64Decode|Base64Encode|BaseTableIDs|ComputeModel|CryptDecrypt|CryptEncrypt|FieldComment|FilterValues|GetAddonInfo|GetAsBoolean|GetEmbedding|GetFieldName|GetNthRecord|GetThumbnail|JSONListKeys|KanjiNumeral|MiddleValues|PatternCount|RangeBeacons|RelationInfo|RomanHankaku|RomanZenkaku|SetPrecision|SetRecursion|TextStyleAdd|UniqueValues|ValueListIDs|Combination|CryptDigest|ExecuteSQLe|FieldBounds|GetAsNumber|GetLiveText|GetTableDDL|KanaHankaku|KanaZenkaku|LayoutNames|MiddleWords|RightValues|ScriptNames|WindowNames|ExecuteSQL|FieldNames|FieldStyle|GetSummary|LeftValues|LookupNext|MonthNameJ|NumToJText|ReadQRCode|RightWords|SortValues|Substitute|TableNames|TextDecode|TextEncode|ValueCount|WeekOfYear|DayOfWeek|DayOfYear|Factorial|FieldType|GetAsDate|GetAsText|GetAsTime|GetHeight|GetSensor|HexDecode|HexEncode|JSONParse|LayoutIDs|LeftWords|MonthName|ScriptIDs|TextColor|Timestamp|VarianceP|WordCount|DayNameJ|Evaluate|FieldIDs|Furigana|GetAsCSS|GetAsSVG|GetField|GetValue|GetWidth|Hiragana|Katakana|Location|Position|TableIDs|TextFont|TextSize|Truncate|Variance|YearName|Average|Ceiling|DayName|Degrees|IsEmpty|IsValid|Radians|Replace|Seconds|TrimAll|Choose|Extend|Filter|Length|Lookup|Middle|Minute|Proper|Random|StDevP|Count|Exact|Floor|Lower|Month|Quote|Right|Round|StDev|Upper|While|Acos|Asin|Atan|Case|Char|Code|Date|Hour|Last|Left|List|Self|Sign|Sqrt|Time|Trim|Year|Abs|Cos|Day|Div|Exp|Int|Let|Log|Max|Min|Mod|NPV|PMT|RGB|Sin|Sum|Tan|FV|If|Lg|Ln|Pi|PV)(?=\\s*\\()",
          "name": "support.function.builtin.fmcalc"
        },
        {
          "comment": "Any other call: custom functions and built-ins not yet in shared data",
          "match": "\\b([\\p{L}_][\\p{L}\\p{N}_.]*)(?=\\s*\\()",
          "name": "entity.name.function.fmcalc"
        }
      ]
    },
    "field-references": {
      "match": "\\b([\\p{L}_][\\p{L}\\p{N}_.]*)\\s*(::)\\s*([\\p{L}_][\\p{L}\\p{N}_.]*)",
      "captures": {
        "1": {
          "name": "entity.name.type.table.fmcalc"
        },
        "2": {
          "name": "punctuation.accessor.fmcalc"
        },
        "3": {
          "name": "variable.other.field.fmcalc"
        }
      }
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.global.fmcalc",
          "match": "\\$\\$[\\p{L}_~][\\p{L}\\p{N}_.~]*"
        },
        {
          "name": "variable.other.local.fmcalc",
          "match": "\\$[\\p{L}_~][\\p{L}\\p{N}_.~]*"
        },
        {
          "name": "variable.other.let.fmcalc",
          "match": "~[\\p{L}\\p{N}_.~]*"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.fmcalc",
          "match": "(?i)\\b(TraditionalChinese|SimplifiedChinese|ValueNumberRanges|JSONStringRanges|DoubleUnderline|HighlightYellow|CentralEurope|Strikethrough|WordUnderline|JSONBoolean|Superscript|ValueNumber|JSONNumber|JSONObject|JSONString|AllStyles|JSONArray|Lowercase|PosixPath|SmallCaps|Subscript|Titlecase|Underline|Uppercase|Condense|Cyrillic|JSONNull|ROWMODID|ShiftJIS|JSONRaw|URLPath|WinPath|Extend|Higher|Italic|Symbol|False|Greek|Lower|Other|Plain|Roman|ROWID|Bold|True|OEM)\\b"
        },
        {
          "name": "keyword.operator.logical.fmcalc",
          "match": "(?i)\\b(and|not|xor|or)\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.fmcalc",
      "match": "(?<![A-Za-z_$])(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.fmcalc",
          "match": "≠|≤|≥|<>|<=|>=|=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.fmcalc",
          "match": "[+\\-*/^]"
        },
        {
          "name": "keyword.operator.concatenation.fmcalc",
          "match": "&"
        },
        {
          "name": "constant.character.paragraph.fmcalc",
          "match": "¶"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.arguments.fmcalc",
          "match": ";"
        },
        {
          "name": "punctuation.section.parens.fmcalc",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.fmcalc",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}
