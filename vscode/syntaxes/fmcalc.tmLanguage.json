{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FileMaker Calculation",
  "scopeName": "source.fmcalc",
  "comment": "GENERATED by scripts/generate-grammar.mjs from shared/data. Do not edit by hand.",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#quoted-names"
        },
        {
          "include": "#get-call"
        },
        {
          "include": "#function-calls"
        },
        {
          "include": "#field-references"
        },
        {
          "include": "#variables"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fmcalc",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fmcalc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.fmcalc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.fmcalc",
          "match": "\\\\."
        },
        {
          "name": "constant.character.paragraph.fmcalc",
          "match": "¶"
        }
      ]
    },
    "quoted-names": {
      "comment": "${ } quotes reserved names used as field or table names",
      "name": "variable.other.quoted.fmcalc",
      "match": "\\$\\{[^}]*\\}"
    },
    "get-call": {
      "comment": "Get ( ConstantName ): any name is accepted, so the grammar does not depend on a complete list",
      "match": "(?i)\\b(Get)\\s*(\\()\\s*([A-Za-z][A-Za-z0-9]*)\\s*(\\))",
      "captures": {
        "1": {
          "name": "support.function.builtin.fmcalc"
        },
        "2": {
          "name": "punctuation.section.arguments.begin.fmcalc"
        },
        "3": {
          "name": "support.constant.get.fmcalc"
        },
        "4": {
          "name": "punctuation.section.arguments.end.fmcalc"
        }
      }
    },
    "function-calls": {
      "patterns": [
        {
          "comment": "Built-in functions from shared data (function names are case-insensitive in FileMaker)",
          "match": "(?i)\\b(Substitute|ValueCount|Timestamp|GetField|GetValue|Average|Middle|Month|Right|Round|Case|Date|Left|List|Time|Year|Abs|Day|Let|Sum|If)(?=\\s*\\()",
          "name": "support.function.builtin.fmcalc"
        },
        {
          "comment": "Any other call: custom functions and built-ins not yet in shared data",
          "match": "\\b([\\p{L}_][\\p{L}\\p{N}_.]*)(?=\\s*\\()",
          "name": "entity.name.function.fmcalc"
        }
      ]
    },
    "field-references": {
      "match": "\\b([\\p{L}_][\\p{L}\\p{N}_.]*)\\s*(::)\\s*([\\p{L}_][\\p{L}\\p{N}_.]*)",
      "captures": {
        "1": {
          "name": "entity.name.type.table.fmcalc"
        },
        "2": {
          "name": "punctuation.accessor.fmcalc"
        },
        "3": {
          "name": "variable.other.field.fmcalc"
        }
      }
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.global.fmcalc",
          "match": "\\$\\$[\\p{L}_~][\\p{L}\\p{N}_.~]*"
        },
        {
          "name": "variable.other.local.fmcalc",
          "match": "\\$[\\p{L}_~][\\p{L}\\p{N}_.~]*"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.fmcalc",
          "match": "(?i)\\b(DoubleUnderline|HighlightYellow|Strikethrough|WordUnderline|JSONBoolean|Superscript|JSONNumber|JSONObject|JSONString|AllStyles|JSONArray|Lowercase|SmallCaps|Subscript|Titlecase|Underline|Uppercase|Condense|JSONNull|JSONRaw|Extend|Italic|False|Plain|Bold|True)\\b"
        },
        {
          "name": "keyword.operator.logical.fmcalc",
          "match": "(?i)\\b(and|not|xor|or)\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.fmcalc",
      "match": "(?<![A-Za-z_$])(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.fmcalc",
          "match": "≠|≤|≥|<>|<=|>=|=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.fmcalc",
          "match": "[+\\-*/^]"
        },
        {
          "name": "keyword.operator.concatenation.fmcalc",
          "match": "&"
        },
        {
          "name": "constant.character.paragraph.fmcalc",
          "match": "¶"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.arguments.fmcalc",
          "match": ";"
        },
        {
          "name": "punctuation.section.parens.fmcalc",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.fmcalc",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}
